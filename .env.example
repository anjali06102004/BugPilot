# BugPilot Phase 1
BUGPILOT_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# SQLite is the default for local Phase 1. Use PostgreSQL in docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/bugpilot.db
REDIS_URL=redis://localhost:6379/0

# Evidence stored on disk (Phase 1). Object storage later.
EVIDENCE_DIR=./data/evidence

# AI — leave empty to run deterministic detectors only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safety
ALLOWED_HOST_SUFFIXES=
BLOCK_PRIVATE_TARGETS=true
MAX_PAGES_HARD_LIMIT=100
MAX_DURATION_SECONDS_HARD_LIMIT=1200
